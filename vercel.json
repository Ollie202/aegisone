{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "builds": [
    {
      "src": "apps/web/src/vercel-entry.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "apps/web/package.json",
          "apps/web/public/**",
          "apps/web/src/**",
          "packages/*/package.json",
          "packages/*/src/**",
          "apps/web/fixtures/**",
          "examples/agent-skills/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/apps/web/src/vercel-entry.ts"
    }
  ]
}
